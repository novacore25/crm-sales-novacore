# ============================================================================
# Supabase connection details for dump-supabase.ps1
# ============================================================================
# Copy this file to `.pgdump.env` and fill in the four values.
#
#   Copy-Item .pgdump.env.example .pgdump.env
#
# `.pgdump.env` is gitignored. Never commit it, never paste its contents into
# a chat or an issue.
# ============================================================================

# --- Where to find these -----------------------------------------------------
# Supabase Dashboard -> your project -> Settings (gear icon) -> Database
#
# There are two connection strings there: "URI" and "Session pooler".
# Use the SESSION POOLER. It is the one on port 5432.

# Host, from the session pooler URI.
# Looks like: aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_HOST=

# User, from the same URI. Always starts with "postgres." followed by the
# project ref, for example: postgres.abcdefghijklm
SUPABASE_DB_USER=

# Password: Settings -> Database -> the database password you set.
# If you have not rotated the credentials that were committed to the old
# repository, rotate them first and use the new value here.
SUPABASE_DB_PASSWORD=

# 5432 = session pooler.  Use this.
# 6543 = transaction pooler. Do NOT use this with pg_dump - it holds one
#        long-lived connection, which transaction mode does not support.
SUPABASE_DB_PORT=5432
