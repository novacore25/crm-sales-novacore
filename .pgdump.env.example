# ============================================================================
# Supabase connection details for dump-supabase.ps1
# ============================================================================
# Copy this file to `.pgdump.env` and fill in the values.
#
#   Copy-Item .pgdump.env.example .pgdump.env
#   notepad .pgdump.env
#
# `.pgdump.env` is gitignored. Never commit it, and never paste its contents
# into a chat, an issue, or a screenshot.
# ============================================================================


# --- OPTION A (recommended): paste the whole connection string ---------------
# In the Supabase dashboard: Settings -> Database -> Connection string ->
# URI. Make sure "Session pooler" is selected, not "Transaction pooler",
# then copy the string and paste it below.
#
# Leave every other field blank; the script parses this one value.
#
SUPABASE_DB_URL=


# --- OPTION B: fill the four fields separately -------------------------------
# Use this only if you cannot get the full URI. Delete every line above.
#
# Supabase Dashboard -> Settings -> Database
#
# Host   = the part after the "@" in the Session pooler URI, e.g.
#          aws-0-ap-southeast-1.pooler.supabase.com
# User   = the part before the first ":" in the Session pooler URI, e.g.
#          postgres.abcdefghijklm
#          (note: the username comes BEFORE the colon here, and includes the
#           project ref after a dot)
# Pass   = the database password you set, not "[YOUR-PASSWORD]"
#
# Port 5432 = session pooler.  Correct for pg_dump.
# Port 6543 = transaction pooler.  Will fail. Do not use.
#
#SUPABASE_DB_HOST=
#SUPABASE_DB_USER=
#SUPABASE_DB_PASSWORD=
#SUPABASE_DB_PORT=5432
