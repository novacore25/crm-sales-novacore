# ============================================================================
# CRM Sales Novacore - environment configuration
# ============================================================================
# Copy to `.env` for local development. In production, set these as
# environment variables on the Coolify application resource, NOT in this file.
# Never commit a filled-in copy.
# ============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development (from your own machine, via Docker):
#   postgresql://postgres:postgres@localhost:5432/db_sales_novacore
#
# Production (Coolify internal URL for the crm-sales-db resource).
# Find it at: Coolify -> crm-sales-db -> Show Credentials -> Internal URL
#
# Use the INTERNAL url, never the external one. The database is not exposed to
# the internet, so an external host will not connect from the container.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/db_sales_novacore"

# ---------------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# Required in production. Without it Auth.js refuses to start.
AUTH_SECRET=""

# Trust the platform's forwarded host/proto headers.
AUTH_TRUST_HOST=true

# Public origin of the app, used to build OAuth redirect URIs.
# Must match the Google OAuth client's Authorised redirect URI exactly.
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0
# Client ID. Add this redirect URI under "Authorised redirect URIs":
#   - http://localhost:3000/api/auth/callback/google   (local)
#   - https://<your-domain>/api/auth/callback/google   (production)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
